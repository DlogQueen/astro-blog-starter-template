---
import HeaderLink from './HeaderLink.astro';
import { BUSINESS_NAME, INSTAGRAM_URL, INSTAGRAM_HANDLE } from '../consts';
---

<header>
	<nav class="wrap">
		<a href="/" class="brand">
			<svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
				<circle cx="24" cy="24" r="16" fill="none" stroke="currentColor" stroke-width="2.5" />
				<path
					d="M24 8c2 3 2 5 0 7M40 24c-3 2-5 2-7 0M24 40c-2-3-2-5 0-7M8 24c3-2 5-2 7 0"
					stroke="currentColor"
					stroke-width="2.5"
					fill="none"
					stroke-linecap="round"
				/>
				<circle cx="24" cy="24" r="3" fill="currentColor" />
			</svg>
			<span class="brand-name">The <em class="script">Glitzy</em> Farmhouse</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/updates">Updates &amp; Events</HeaderLink>
			<HeaderLink href="/#contact">Contact</HeaderLink>
		</div>
		<div class="social-links">
			<a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Follow {BUSINESS_NAME} on Instagram ({INSTAGRAM_HANDLE})</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="26" height="26" fill="none">
					<rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="currentColor" stroke-width="1.8" />
					<circle cx="12" cy="12" r="4.6" stroke="currentColor" stroke-width="1.8" />
					<circle cx="17.6" cy="6.4" r="1.15" fill="currentColor" />
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0;
		background: var(--ivory);
		border-bottom: 1px solid var(--border);
		position: sticky;
		top: 0;
		z-index: 20;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		flex-wrap: wrap;
		padding: 0.85em 0;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		color: rgb(var(--ink));
	}
	.brand-mark {
		width: 34px;
		height: 34px;
		color: var(--terracotta);
		flex-shrink: 0;
	}
	.brand-name {
		font-family: 'Playfair Display', serif;
		font-weight: 700;
		font-size: 1.15em;
		white-space: nowrap;
	}
	.brand-name em {
		font-style: normal;
		color: var(--terracotta-dark);
		font-size: 1.35em;
		vertical-align: -0.08em;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}
	.internal-links :global(a) {
		padding: 0.6em 0.75em;
		color: rgb(var(--ink));
		font-weight: 700;
		font-size: 0.92em;
		border-bottom: 2px solid transparent;
	}
	.internal-links :global(a.active) {
		border-bottom-color: var(--terracotta);
		color: var(--terracotta-dark);
	}
	.social-links a {
		display: flex;
		color: rgb(var(--ink));
	}
	.social-links a:hover {
		color: var(--terracotta);
	}
	@media (max-width: 640px) {
		.brand-name {
			font-size: 1em;
		}
		.internal-links :global(a) {
			padding: 0.5em 0.5em;
			font-size: 0.85em;
		}
	}
</style>
