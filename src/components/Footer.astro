---
import { BUSINESS_NAME, OWNER_NAME, LOCATION, INSTAGRAM_URL, INSTAGRAM_HANDLE } from '../consts';
const today = new Date();
---

<footer>
	<div class="wrap footer-inner">
		<div class="footer-brand">
			<p class="footer-title">The <em class="script">Glitzy</em> Farmhouse</p>
			<p class="footer-tagline">Handmade wreaths &amp; seasonal decor, made to order in {LOCATION}.</p>
		</div>
		<nav class="footer-links" aria-label="Footer">
			<a href="/">Home</a>
			<a href="/about">About</a>
			<a href="/updates">Updates &amp; Events</a>
			<a href="/#contact">Contact</a>
		</nav>
		<div class="social-links">
			<a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none">
					<rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="currentColor" stroke-width="1.8" />
					<circle cx="12" cy="12" r="4.6" stroke="currentColor" stroke-width="1.8" />
					<circle cx="17.6" cy="6.4" r="1.15" fill="currentColor" />
				</svg>
				<span>{INSTAGRAM_HANDLE}</span>
			</a>
		</div>
	</div>
	<div class="wrap">
		<p class="fine-print">
			&copy; {today.getFullYear()} {BUSINESS_NAME}. Handcrafted by {OWNER_NAME}. All rights reserved.
		</p>
	</div>
</footer>
<style>
	footer {
		padding: 3.5em 0 2em 0;
		background: rgb(var(--ink));
		color: rgba(255, 253, 249, 0.85);
	}
	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		gap: 2em;
		align-items: flex-start;
		justify-content: space-between;
		padding-bottom: 2em;
		border-bottom: 1px solid rgba(255, 253, 249, 0.15);
		margin-bottom: 1.5em;
	}
	.footer-title {
		font-family: 'Playfair Display', serif;
		font-size: 1.4em;
		font-weight: 700;
		color: var(--ivory);
		margin: 0 0 0.3em 0;
	}
	.footer-title em {
		font-style: normal;
		color: var(--gold);
	}
	.footer-tagline {
		margin: 0;
		max-width: 320px;
		color: rgba(255, 253, 249, 0.7);
	}
	.footer-links {
		display: flex;
		flex-direction: column;
		gap: 0.6em;
	}
	.footer-links a {
		color: rgba(255, 253, 249, 0.85);
		text-decoration: none;
		font-weight: 600;
	}
	.footer-links a:hover {
		color: var(--gold);
	}
	.social-links a {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		color: var(--ivory);
		font-weight: 700;
		border: 1px solid rgba(255, 253, 249, 0.3);
		border-radius: 999px;
		padding: 0.6em 1.1em;
		height: fit-content;
	}
	.social-links a:hover {
		border-color: var(--gold);
		color: var(--gold);
	}
	.fine-print {
		margin: 0;
		font-size: 0.85em;
		color: rgba(255, 253, 249, 0.55);
		text-align: center;
	}
</style>
